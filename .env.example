# Database (PostgreSQL)
DATABASE_URL=postgresql://user:pass@localhost:5432/database

# Kunci enkripsi cookie session, minimal 32 karakter.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Zona waktu: Asia/Jakarta (WIB), Asia/Makassar (WITA), Asia/Jayapura (WIT)
APP_TIMEZONE=Asia/Jakarta

# Penyimpanan file: Cloudflare R2 (bucket PRIVAT, jangan aktifkan akses publik).
# 1. Cloudflare Dashboard → R2 → Create bucket, misal "sakudagang-files".
# 2. R2 → Manage API tokens → Create API token, izin "Object Read & Write",
#    batasi ke bucket di atas. Salin Access Key ID & Secret Access Key.
# 3. Account ID ada di halaman R2 (kanan atas).
# CORS tidak perlu diatur: file diunggah lewat server aplikasi, bukan langsung dari browser.
# Kosongkan keempatnya saat development: file disimpan di folder .storage/ (tidak ikut git).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Kunci endpoint cron /api/cron/* (minimal 16 karakter).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# - Vercel: jadwal ada di vercel.json; Vercel mengirim header Authorization otomatis.
# - Hosting lain: panggil terjadwal dengan header Authorization, misal crontab:
#   0 1 * * * curl -s -H "Authorization: Bearer <CRON_SECRET>" https://domain-anda/api/cron/example
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
